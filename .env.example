# Generation and follow-up rewriting: gpt-6-luna.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: if the above key also allows text-embedding-3-small, set:
# OPENAI_EMBEDDING_API_KEY=${OPENAI_API_KEY}
# Alternatively use a dedicated embedding key. Leave blank for Elasticsearch only.
OPENAI_EMBEDDING_API_KEY=
# Qdrant Cloud (hybrid mode only)
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=replace_me

# Obsidian 노트 경로 (절대 경로)
OBSIDIAN_VAULT_PATH=C:/path/to/your/obsidian/vault

# Docker 내부 서비스 (docker-compose 기본값)
ELASTICSEARCH_HOST=http://elasticsearch:9200
REDIS_HOST=redis
REDIS_PORT=6379

# 선택 설정
CACHE_TTL=1800
INTERVAL_SECONDS=600
